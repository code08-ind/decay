---
import '../styles/site.css';
import { SUPPORT_EMAIL } from '../consts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Decay quietly archives the browser tabs and app windows you stopped using, and brings any of them back with one shortcut. Local-only, no account.' } = Astro.props;
const full = title === 'Decay' ? 'Decay — Your tabs, gently put away' : `${title} · Decay`;
const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/privacy', label: 'Privacy' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <header class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5">
      <a href="/" class="flex items-center gap-2 font-serif text-xl">
        <img src="/icon.png" alt="" width="28" height="28" class="rounded-lg" />
        Decay
      </a>
      <nav aria-label="Site" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
        {nav.map((n) => <a href={n.href} class="hidden hover:text-ink sm:inline">{n.label}</a>)}
        <a href="/download" class="rounded-full bg-primary px-4 py-2 font-medium text-primary-ink">Download</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto mt-24 flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-line px-5 py-8 text-sm text-muted">
      <p>© 2026 Aryan Garg · Decay · <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-ink">{SUPPORT_EMAIL}</a></p>
      <nav aria-label="Footer" class="flex flex-wrap gap-5">
        <a href="/docs" class="hover:text-ink">Docs</a>
        <a href="/privacy" class="hover:text-ink">Privacy</a>
        <a href="/terms" class="hover:text-ink">Terms</a>
        <a href="/refunds" class="hover:text-ink">Refunds</a>
        <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-ink">Contact</a>
        <a href="https://github.com/code08-ind/decay" class="hover:text-ink">Source</a>
        <a href="https://github.com/code08-ind/decay-releases/releases" class="hover:text-ink">Changelog</a>
      </nav>
    </footer>
  </body>
</html>
