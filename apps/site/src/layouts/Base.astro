---
import '../styles/site.css';
import Search from '../components/Search.astro';
import { SUPPORT_EMAIL, cleanPath } from '../consts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Decay quietly archives the browser tabs and app windows you stopped using, and brings any of them back with one shortcut. Local-only, no account.' } = Astro.props;
const full = title === 'Decay' ? 'Decay — Your tabs, gently put away' : `${title} · Decay`;
const here = cleanPath(Astro.url.pathname);
const canonical = new URL(here, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/privacy', label: 'Privacy' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f3e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121410" media="(prefers-color-scheme: dark)" />
    <!-- Link previews (Product Hunt, X, Slack, WhatsApp…). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Decay" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Decay: Your tabs, gently put away." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Theme before first paint (no flash): the saved choice, else the OS. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('decay-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <header class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-5 max-[359px]:px-4">
      <a href="/" class="flex shrink-0 items-center gap-2 font-serif text-xl">
        <img src="/icon.png" alt="" width="28" height="28" class="rounded-lg" />
        <span class="max-[359px]:sr-only">Decay</span>
      </a>
      <nav aria-label="Site" class="flex items-center gap-x-2 text-sm text-muted max-[359px]:gap-x-1 sm:gap-x-5">
        {nav.map((n) => {
          const current = n.href === '/docs' ? here.startsWith('/docs') : here === n.href;
          return (
            <a href={n.href} aria-current={current ? 'page' : undefined} class:list={['hidden hover:text-ink md:inline', current && 'font-medium text-ink']}>
              {n.label}
            </a>
          );
        })}
        <Search />
        <button
          type="button"
          id="theme-toggle"
          aria-label="Toggle theme"
          title="Toggle theme (Shift+T)"
          class="theme-toggle grid size-9 place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-ink"
        >
          <svg class="icon-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <svg class="icon-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
        </button>
        <!-- Phones and small tablets: the page links in a menu. -->
        <details id="site-menu" class="relative md:hidden">
          <summary aria-label="Menu" class="grid size-9 cursor-pointer list-none place-items-center rounded-full hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <div class="absolute end-0 top-11 z-20 grid w-52 gap-0.5 rounded-2xl border border-line bg-surface p-2 text-base shadow-panel">
            {nav.map((n) => <a href={n.href} class="rounded-xl px-3 py-2 text-ink hover:bg-surface-2">{n.label}</a>)}
          </div>
        </details>
        <a href="/download?os=auto" class="ms-1 rounded-full bg-primary px-4 py-2 font-medium text-primary-ink sm:ms-0">Download</a>
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="mx-auto mt-24 w-full max-w-6xl px-5 text-sm text-muted">
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-8">
      <p>© 2026 Aryan Garg · Decay · <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-ink">{SUPPORT_EMAIL}</a></p>
      <nav aria-label="Footer" class="flex flex-wrap gap-5">
        <a href="/docs" class="hover:text-ink">Docs</a>
        <a href="/privacy" class="hover:text-ink">Privacy</a>
        <a href="/terms" class="hover:text-ink">Terms</a>
        <a href="/refunds" class="hover:text-ink">Refunds</a>
        <a href={`mailto:${SUPPORT_EMAIL}`} class="hover:text-ink">Contact</a>
        <a href="https://github.com/code08-ind/decay" class="hover:text-ink">Source</a>
        <a href="https://github.com/code08-ind/decay-releases/releases" class="hover:text-ink">Changelog</a>
      </nav>
      </div>
    </footer>
    <script>
      // Light / dark toggle, like aryangarg.com: the new theme sweeps over the page as a
      // circle growing from the top-left corner to the bottom-right (View Transitions).
      const KEY = 'decay-theme';
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const osDark = matchMedia('(prefers-color-scheme: dark)');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

      const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');
      const label = () => {
        button?.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      };
      const saved = () => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          return null;
        }
      };

      function toggle() {
        const next = current() === 'dark' ? 'light' : 'dark';
        const apply = () => {
          root.dataset.theme = next;
          label();
        };
        try {
          localStorage.setItem(KEY, next);
        } catch {}

        if (!('startViewTransition' in document) || reduceMotion.matches) {
          apply();
          return;
        }
        const transition = document.startViewTransition(apply);
        transition.ready.then(() => {
          const end = Math.hypot(innerWidth, innerHeight);
          root.animate(
            { clipPath: ['circle(0px at 0px 0px)', `circle(${end}px at 0px 0px)`] },
            { duration: 600, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
          );
        });
      }

      label();
      button?.addEventListener('click', toggle);

      // Phone menu: close it after picking a link (same-page #links don't navigate away)
      // and when tapping anywhere else.
      const menu = document.getElementById('site-menu') as HTMLDetailsElement | null;
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) menu.open = false;
      });
      document.addEventListener('click', (e) => {
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });

      // Shift+T, as on aryangarg.com (not while typing, never with Ctrl/Cmd/Alt).
      document.addEventListener('keydown', (e) => {
        const el = e.target as HTMLElement | null;
        const typing = el && (/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || el.isContentEditable);
        if (!typing && e.shiftKey && !e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 't') {
          e.preventDefault();
          toggle();
        }
      });

      // Until the visitor picks a theme, follow the OS when it changes.
      osDark.addEventListener('change', (e) => {
        if (saved() !== 'light' && saved() !== 'dark') {
          root.dataset.theme = e.matches ? 'dark' : 'light';
          label();
        }
      });
    </script>
  </body>
</html>
