---
// Buying Decay Pro (P4.3): Paddle's checkout opens over this page. It's also Paddle's
// "default payment link": Paddle sends buyers here with `?_ptxn=<transaction>`, and
// Paddle.js then opens that transaction's checkout itself.
import { PADDLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="Buy Decay Pro" description="Decay Pro: a one-time $24, with a 14-day free trial first.">
  <section class="mx-auto max-w-2xl px-5 pt-10 text-center">
    <h1 class="font-serif text-5xl">Decay Pro</h1>
    <p class="mt-4 text-lg text-muted">A one-time <strong class="text-ink">$24</strong>. Works on all your computers, never expires, no account.</p>
    <button
      id="buy"
      type="button"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 font-medium text-primary-ink disabled:opacity-60"
      disabled
    >
      Buy Decay Pro — $24
    </button>
    <p id="buy-error" role="alert" class="mt-4 hidden text-sm text-danger">
      The checkout couldn't load. Check your connection (or a content blocker), then reload this page.
    </p>
    <p class="mt-8 text-sm text-muted">
      Checkout, payment, tax and refunds are handled by Paddle, our merchant of record
      (<a class="underline" href="/terms">Terms</a> · <a class="underline" href="/refunds">Refund Policy</a>).
      Your license key arrives by email; paste it into Decay → Settings → Decay Pro.
    </p>
    <p class="mt-3 text-sm text-faint">Not sure yet? <a class="underline" href="/docs/pro">Try Pro free for 14 days</a> first.</p>
  </section>
  <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
  <script is:inline define:vars={{ paddle: PADDLE }}>
    (() => {
      const button = document.getElementById('buy');
      const failed = () => document.getElementById('buy-error')?.classList.remove('hidden');
      if (!window.Paddle) return failed();
      if (paddle.environment === 'sandbox') window.Paddle.Environment.set('sandbox');
      window.Paddle.Initialize({ token: paddle.clientToken });
      const open = () =>
        window.Paddle.Checkout.open({
          items: [{ priceId: paddle.priceId, quantity: 1 }],
          settings: {
            displayMode: 'overlay',
            successUrl: new URL('/thanks', location.origin).href,
          },
        });
      button.disabled = false;
      button.addEventListener('click', open);
      // Paddle's own links (?_ptxn=…) are opened by Paddle.js; otherwise open ours.
      if (!new URLSearchParams(location.search).has('_ptxn')) open();
    })();
  </script>
</Base>
