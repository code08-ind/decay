---
// The landing page (Designs/17), with only what Decay does today: no sync, no device
// limit, no sample numbers. Firefox is marked "soon" until its Firefox Add-ons listing is approved.
import OsIcon from '../components/OsIcon.astro';
import Base from '../layouts/Base.astro';
import { REPO } from '../consts';

const works = ['Google Chrome', 'Microsoft Edge', 'Brave', 'Firefox (soon)', 'macOS Finder', 'Windows Explorer'];
const results = [
  { letter: 'S', title: 'Stripe pricing — Compare plans', where: 'stripe.com / pricing', why: 'Unused 61 active h' },
  { letter: 'L', title: 'Linear — Cycle 42 roadmap', where: 'linear.app', why: 'Unused 48 active h' },
  { letter: 'G', title: 'Pull request #418: cache logic', where: 'github.com', why: 'Unused 24 active h' },
];
const free = [
  'Tab archiving by active time, with Undo',
  'Search and restore anything, one at a time',
  'Hiding app windows you stopped using',
  'Rules: always keep, never record',
  '3 custom timing rules',
  '90 days of archive',
  'Export and import',
];
const pro = [
  'Everything in Free',
  'Closes stale Finder and Explorer folder windows (they reopen from the archive)',
  'Restore a whole batch at once, in its original order',
  'Keep the archive as long as you like',
  'Unlimited custom timing rules',
  'Names for archived batches, made on your computer',
];
const faq = [
  {
    q: 'Will Decay close a page I’m typing in?',
    a: 'No. With your permission it checks a page for unsaved typing, an upload or a “leave site?” prompt right before archiving it, and skips it. Pinned tabs, tabs playing audio and sites you mark “always keep” are never touched.',
  },
  {
    q: 'How does it decide a tab is stale?',
    a: 'By active time: time only counts while you’re actually using your computer. A weekend away doesn’t make Monday’s tabs old. And sweeps wait while you’re in a call or a meeting.',
  },
  {
    q: 'Does anything leave my computer?',
    a: 'No account, no analytics. The app checks for updates once a day; crash reports are off unless you turn them on. Everything Decay records stays on your computer, in an encrypted database.',
  },
  {
    q: 'What if I need a tab back months later?',
    a: 'Search finds anything in the archive by title, site or address. The free version keeps 90 days; Decay Pro keeps it as long as you choose.',
  },
  {
    q: 'Is it a subscription?',
    a: 'No. Decay is free; Decay Pro is a one-time $24 (plus local tax where it applies), with a 14-day free trial and no account.',
  },
];
---

<Base title="Decay">
  <section class="mx-auto max-w-4xl px-5 pt-12 text-center">
    <p class="mx-auto mb-6 inline-flex rounded-full bg-chip px-3 py-1 text-xs font-medium text-chip-ink">
      macOS &amp; Windows · Chrome, Edge &amp; Brave · Firefox soon
    </p>
    <h1 class="font-serif text-5xl leading-[1.05] md:text-7xl">Your tabs, gently put away.</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">
      Decay watches what you actually use and quietly archives the rest. Search and restore
      anything in a keystroke — nothing is ever lost.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/download?os=mac" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 font-medium text-primary-ink"><OsIcon os="mac" />Download for Mac</a>
      <a href="/download?os=windows" class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-surface px-6 py-3 font-medium"><OsIcon os="windows" size={16} />Download for Windows</a>
    </div>
    <p class="mt-4 text-sm text-faint">Free · Decay Pro is a one-time $24 · no account</p>
  </section>

  <section aria-label="The search panel" class="mx-auto mt-16 max-w-3xl px-5">
    <div class="rounded-[28px] bg-feature p-6 shadow-lg md:p-10">
      <div class="rounded-2xl bg-surface p-3 shadow-xl">
        <div class="flex items-center gap-3 rounded-xl bg-surface-2 px-4 py-3">
          <span aria-hidden="true" class="text-faint">⌕</span>
          <span class="flex-1 text-start">pricing<span class="animate-pulse">|</span></span>
          <span class="rounded-md bg-surface px-2 py-0.5 font-mono text-xs text-muted">⌥⌘D</span>
        </div>
        <ul class="mt-2 grid gap-1 text-start">
          {results.map((r, i) => (
            <li class:list={['flex min-w-0 items-center gap-3 rounded-xl px-3 py-2.5', i === 0 && 'bg-lime text-lime-ink']}>
              {/* On the lime (selected) row the tile is a tint of the row's own ink, so the letter reads in both themes. */}
              <span aria-hidden="true" class:list={['grid size-8 shrink-0 place-items-center rounded-lg text-sm font-semibold', i === 0 ? 'bg-lime-ink/12 text-lime-ink' : 'bg-surface-3']}>{r.letter}</span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium">{r.title}</span>
                <span class:list={['block truncate font-mono text-xs', i === 0 ? 'opacity-80' : 'text-muted']}>{r.where}</span>
              </span>
              <span class:list={['hidden font-mono text-[11px] sm:block', i === 0 ? 'opacity-80' : 'text-faint']}>{r.why}</span>
              {i === 0 && <span class="hidden shrink-0 font-mono text-xs opacity-80 sm:inline">↵ Restore</span>}
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-4 text-center text-sm text-feature-sub">Type a few letters, press Return: the tab is back in its window.</p>
    </div>
  </section>

  <section aria-label="Works with" class="mx-auto mt-16 max-w-5xl px-5 text-center">
    <p class="text-xs font-semibold tracking-wider text-faint uppercase">Works quietly with</p>
    <ul class="mt-4 flex flex-wrap justify-center gap-x-8 gap-y-3 text-muted">
      {works.map((w) => <li>{w}</li>)}
    </ul>
  </section>

  <section id="how" class="mx-auto mt-28 max-w-6xl scroll-mt-8 px-5">
    <p class="text-center text-xs font-semibold tracking-wider text-accent-text uppercase">Calm automation</p>
    <h2 class="mt-2 text-center font-serif text-4xl">How Decay stays out of your way.</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted">
      Your tabs should reflect what’s on your mind now, not every question you looked into this month.
    </p>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-line bg-surface p-6">
        <p class="grid size-8 place-items-center rounded-full bg-chip text-sm font-semibold text-chip-ink">1</p>
        <h3 class="mt-4 font-serif text-2xl">It watches quietly</h3>
        <p class="mt-2 text-muted">Time only counts while you’re working: screen locked, asleep or away, nothing ages. While you’re in a call, sweeps wait.</p>
      </article>
      <article class="rounded-3xl border border-line bg-surface p-6">
        <p class="grid size-8 place-items-center rounded-full bg-chip text-sm font-semibold text-chip-ink">2</p>
        <h3 class="mt-4 font-serif text-2xl">Stale things fade</h3>
        <p class="mt-2 text-muted">Fresh while you use them, stale when you don’t, then archived in small, quiet sweeps. Idle app windows are minimised out of the way.</p>
        <ol class="mt-4 flex flex-wrap gap-2 text-xs">
          {['Fresh', 'Stale', 'Hidden', 'Archived'].map((s) => <li class="rounded-full bg-surface-2 px-2.5 py-1">{s}</li>)}
        </ol>
      </article>
      <article class="rounded-3xl border border-line bg-surface p-6">
        <p class="grid size-8 place-items-center rounded-full bg-chip text-sm font-semibold text-chip-ink">3</p>
        <h3 class="mt-4 font-serif text-2xl">Everything comes back</h3>
        <p class="mt-2 text-muted">Press <kbd class="rounded bg-surface-2 px-1.5 font-mono text-sm">⌥⌘D</kbd> (Windows: <kbd class="rounded bg-surface-2 px-1.5 font-mono text-sm">Ctrl+Alt+D</kbd>), type a word or a site, press Return. The tab reopens in its original window.</p>
      </article>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-5">
    <h2 class="text-center font-serif text-4xl">Built to be trusted with your tabs.</h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl bg-feature p-8 text-feature-ink">
        <p class="text-xs font-semibold tracking-wider text-feature-sub uppercase">Shadow mode first</p>
        <h3 class="mt-2 font-serif text-3xl">For a week, Decay only shows what it would do.</h3>
        <p class="mt-3 text-feature-sub">Nothing is closed while you check its judgement. Turn on automatic mode only when you’re comfortable.</p>
      </article>
      <article class="rounded-3xl border border-line bg-surface p-8">
        <h3 class="font-serif text-2xl">Undo any sweep</h3>
        <p class="mt-2 text-muted">Every sweep is small and comes with Undo. Recent sweeps stay in the Library, ready to put back.</p>
      </article>
      <article class="rounded-3xl border border-line bg-surface p-8">
        <h3 class="font-serif text-2xl">Never touches what you’re using</h3>
        <p class="mt-2 text-muted">Pinned tabs, tabs playing audio, pages you’re typing in, and sites you mark “always keep”. Windows are only ever minimised; only folder windows are closed (Pro).</p>
      </article>
      <article class="rounded-3xl border border-line bg-surface p-8">
        <h3 class="font-serif text-2xl">Rules in plain language</h3>
        <p class="mt-2 text-muted">“Always keep mail.google.com”, “never record my bank”, “let YouTube go sooner”. Test a rule against your open tabs before saving it.</p>
      </article>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-6xl px-5">
    <div class="rounded-[32px] bg-feature px-8 py-14 text-feature-ink">
      <p class="text-center text-xs font-semibold tracking-wider text-feature-sub uppercase">Private by design</p>
      <h2 class="mt-2 text-center font-serif text-4xl">Local-only. Open core.</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="rounded-2xl bg-feature-tile p-6">
          <h3 class="font-semibold">Stays on your computer</h3>
          <p class="mt-2 text-sm text-feature-sub">Everything Decay records is in an encrypted database on your computer. No account, no analytics.</p>
        </div>
        <div class="rounded-2xl bg-feature-tile p-6">
          <h3 class="font-semibold">Check it yourself</h3>
          <p class="mt-2 text-sm text-feature-sub">The engine, the storage and the browser extension are open source. <a class="underline" href={REPO}>Read the code</a>.</p>
        </div>
        <div class="rounded-2xl bg-feature-tile p-6">
          <h3 class="font-semibold">Quiet on the network</h3>
          <p class="mt-2 text-sm text-feature-sub">A daily update check, and crash reports only if you turn them on. That’s all.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="mx-auto mt-28 max-w-5xl scroll-mt-8 px-5">
    <h2 class="text-center font-serif text-4xl">Fair software, no subscription.</h2>
    <p class="mt-3 text-center text-muted">Free for good. Decay Pro is a one-time $24.</p>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <article class="flex flex-col rounded-3xl border-2 border-line bg-surface p-8">
        <h3 class="font-serif text-2xl">Free</h3>
        <p class="mt-1 text-sm text-muted"><span class="font-serif text-3xl text-ink">$0</span> forever · no account</p>
        <ul class="mt-6 grid gap-2.5 text-sm">
          {free.map((f) => (
            <li class="flex gap-2.5">
              <svg class="mt-0.5 size-4 shrink-0 text-accent-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-8">
          <a href="/download?os=auto" class="inline-block rounded-full border border-line-strong px-5 py-2.5 font-medium">Download free</a>
        </div>
      </article>
      <article class="flex flex-col rounded-3xl border-2 border-accent bg-surface p-8">
        <h3 class="font-serif text-2xl">Decay Pro</h3>
        <p class="mt-1 text-sm text-muted"><span class="font-serif text-3xl text-ink">$24</span> one-time + local tax · 14-day free trial · no account</p>
        <ul class="mt-6 grid gap-2.5 text-sm">
          {pro.map((f) => (
            <li class="flex gap-2.5">
              <svg class="mt-0.5 size-4 shrink-0 text-accent-text" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center gap-4 pt-8">
          <a href="/buy" class="inline-block rounded-full bg-primary px-5 py-2.5 font-medium text-primary-ink">Buy Decay Pro — $24</a>
          <a href="/docs/pro" class="text-sm text-muted underline underline-offset-2 hover:text-ink">About Decay Pro</a>
        </div>
      </article>
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-3xl px-5">
    <h2 class="text-center font-serif text-4xl">Questions</h2>
    <div class="mt-8 grid gap-3">
      {faq.map((f) => (
        <details class="faq rounded-2xl border border-line bg-surface px-5 py-4 transition-colors hover:border-line-strong">
          <summary class="flex cursor-pointer items-center gap-4 font-medium">{f.q}</summary>
          <p class="mt-2 pe-8 text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-28 max-w-3xl px-5 text-center">
    <h2 class="font-serif text-4xl">Close fewer tabs. Lose nothing.</h2>
    <p class="mt-3 text-muted">Start with a week of shadow mode and see what Decay would tidy up.</p>
    <a href="/download?os=auto" class="mt-8 inline-block rounded-full bg-primary px-6 py-3 font-medium text-primary-ink">Download Decay</a>
  </section>
</Base>
