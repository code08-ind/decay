{
  "name": "@decay/extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit && tsc -p scripts --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=60000",
    "postinstall": "wxt prepare",
    "parity": "tsx scripts/policy-parity.ts",
    "bridge-fixtures": "tsx scripts/bridge-fixtures.ts"
  },
  "dependencies": {
    "@decay/ui": "workspace:*",
    "dexie": "4.4.7",
    "lucide-react": "1.69.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@decay/config": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.18.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
