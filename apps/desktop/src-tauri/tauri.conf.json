{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decay",
  "version": "0.1.0",
  "identifier": "com.decay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Productivity",
    "shortDescription": "Tabs and windows you stopped using quietly archive themselves",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "files": {
        "MacOS/decay-host": "sidecar/decay-host",
        "MacOS/decay-labeler": "sidecar/decay-labeler"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["decay"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NEU2NkM2QzJDQ0YyODYKUldTRzhzekN4bVpPbUZ1eC9wRi90cG4wWjhwdmtnUlVvSGJVcnRPRnVJaUxlNG0yRnhJSklOeXgK",
      "endpoints": [
        "https://github.com/code08-ind/decay-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
