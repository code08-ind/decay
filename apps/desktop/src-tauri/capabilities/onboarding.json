{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "First run: browsers and the extension, Accessibility, pace, finishing onboarding",
  "windows": ["onboarding"],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-title",
    "core:window:allow-is-maximized",
    "allow-get-status",
    "allow-get-settings",
    "allow-system-language",
    "allow-detect-browsers",
    "allow-install-native-hosts",
    "allow-open-extension-store",
    "allow-request-accessibility",
    "allow-complete-onboarding",
    "allow-set-launch-at-login",
    "allow-ui-show-window",
    "allow-log-ui-error"
  ]
}
