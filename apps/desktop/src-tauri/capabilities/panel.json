{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The search panel: status, its own visibility, opening the Library",
  "windows": ["panel"],
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "allow-get-status",
    "allow-ui-hide-panel",
    "allow-ui-show-window",
    "allow-ui-take-pending"
  ]
}
