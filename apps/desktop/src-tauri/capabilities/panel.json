{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The search panel: search, restore, protect, details, status, its own visibility",
  "windows": ["panel"],
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "allow-get-status",
    "allow-ui-hide-panel",
    "allow-ui-show-window",
    "allow-ui-take-pending",
    "allow-get-settings",
    "allow-search",
    "allow-restore-items",
    "allow-restore-batch",
    "allow-protect-item",
    "allow-ui-show-item",
    "allow-log-ui-error",
    "allow-record-search"
  ]
}
