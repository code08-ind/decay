{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings: its settings, rules, browsers, the hotkey, launch at login, Accessibility, and a waiting license key",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-hotkey",
    "allow-set-launch-at-login",
    "allow-request-accessibility",
    "allow-ui-show-window",
    "allow-ui-take-pending",
    "allow-list-rules",
    "allow-create-rule",
    "allow-update-rule",
    "allow-delete-rule",
    "allow-test-rule",
    "allow-preview-exclude",
    "allow-set-mode",
    "allow-resume",
    "allow-detect-browsers",
    "allow-install-native-hosts",
    "allow-open-extension-store",
    "allow-get-update-state",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-export-archive",
    "allow-import-archive",
    "allow-confirm-import"
  ]
}
