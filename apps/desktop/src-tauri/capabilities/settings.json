{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings: its settings, the hotkey, launch at login, Accessibility, and a waiting license key",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-hotkey",
    "allow-set-launch-at-login",
    "allow-request-accessibility",
    "allow-ui-show-window",
    "allow-ui-take-pending"
  ]
}
