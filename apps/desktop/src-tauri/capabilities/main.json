{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Library window: archive, sweeps, shadow review and the tray controls",
  "windows": ["library"],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-set-mode",
    "allow-resume",
    "allow-hold",
    "allow-release-hold",
    "allow-run-sweep-now",
    "allow-undo-sweep",
    "allow-set-hotkey",
    "allow-set-launch-at-login",
    "allow-request-accessibility",
    "allow-ui-show-window",
    "allow-ui-hide-panel",
    "allow-ui-take-pending",
    "allow-get-settings",
    "allow-get-daily-summary",
    "allow-create-rule",
    "allow-update-settings",
    "allow-search",
    "allow-restore-items",
    "allow-restore-batch",
    "allow-protect-item",
    "allow-ui-show-item",
    "allow-library-stats",
    "allow-get-item",
    "allow-delete-items",
    "allow-list-sweeps",
    "allow-get-sweep",
    "allow-get-shadow-report"
  ]
}
