{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Library window: archive, sweeps, shadow review, the tray controls and the license (P4.2)",
  "windows": ["library"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-get-status",
    "allow-get-license",
    "allow-activate-license",
    "allow-deactivate-license",
    "allow-start-trial",
    "allow-set-mode",
    "allow-resume",
    "allow-hold",
    "allow-release-hold",
    "allow-run-sweep-now",
    "allow-undo-sweep",
    "allow-set-hotkey",
    "allow-set-launch-at-login",
    "allow-request-accessibility",
    "allow-ui-show-window",
    "allow-ui-hide-panel",
    "allow-ui-take-pending",
    "allow-get-settings",
    "allow-system-language",
    "allow-get-daily-summary",
    "allow-create-rule",
    "allow-update-settings",
    "allow-search",
    "allow-restore-items",
    "allow-restore-batch",
    "allow-protect-item",
    "allow-ui-show-item",
    "allow-library-stats",
    "allow-get-item",
    "allow-delete-items",
    "allow-list-sweeps",
    "allow-get-sweep",
    "allow-get-shadow-report",
    "allow-export-archive",
    "allow-log-ui-error",
    "allow-get-metrics",
    "allow-save-metrics-file",
    "allow-open-link",
    "allow-ui-show-whats-new",
    "allow-whats-new",
    "allow-whats-new-seen"
  ]
}
